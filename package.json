{
  "name": "bedest",
  "version": "2.0.0",
  "description": "B.E.D. Stack Boilerplate",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "bedest-core": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "elysia-rate-limit": "^4.6.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@elysiajs/eden": "^1.4.9",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist && bun build src/scripts/database/Migrate.ts --target bun --outfile ./dist/migrate.js && bun build src/scripts/database/ProvisionRoles.ts --target bun --outfile ./dist/provision-roles.js",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "lint": "eslint 'src/**/*.{ts,js}' 'client/**/*.ts' drizzle.config.ts eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint",
    "format": "prettier --write \"src/**/*.ts\" \"client/**/*.ts\" drizzle.config.ts eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"client/**/*.ts\" drizzle.config.ts eslint.config.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun run src/scripts/database/Migrate.ts",
    "db:check": "drizzle-kit check",
    "db:reset": "bun run src/scripts/database/DatabaseReset.ts && bun run src/scripts/storage/StorageReset.ts",
    "db:seed": "bun run src/scripts/seed/seed.ts",
    "db:setup": "bun run db:reset && bun run db:migrate && bun run db:seed",
    "dev:setup": "bun run db:setup"
  }
}
