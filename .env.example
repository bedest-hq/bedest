# Runtime mode (REQUIRED): development | test | production. There is no default.
NODE_ENV=development
# Allowed browser origins, comma-separated (REQUIRED in production, no "*").
CORS_ORIGINS=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db_name
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_MIGRATION_DIR=drizzle

SECRET_KEY=super-secret-key
REFRESH_KEY=super-secret-refresh-key

PORT=3000

LOCAL_STORAGE_PATH=./uploads

#S3_BUCKET=your-bucket-name
#S3_REGION=us-east-1
#S3_ACCESS_KEY=your-access-key
#S3_SECRET_KEY=your-secret-key
#S3_ENDPOINT=http://localhost:9000

# --- Seed script only (bun run db:seed); never read by the server ---
# E-mail of the initial SYSTEM user (REQUIRED for seeding).
SEED_SYSTEM_EMAIL=admin@example.com
# Optional. When unset a random 24-character password is generated and printed once.
#SEED_SYSTEM_PASSWORD=
# Seeding is refused when NODE_ENV=production unless this is true.
#ALLOW_PRODUCTION_SEED=false

# --- Client IP & rate limiting ---
# Number of trusted reverse proxies in front of the app. 0 (default) ignores
# X-Forwarded-For; N uses the entry at position -N of X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Login attempts per minute per (client IP + e-mail). Default 5.
RATE_LIMIT_LOGIN_PER_MIN=5
# Login attempts per minute per client IP, any e-mail. Default 20.
RATE_LIMIT_LOGIN_IP_PER_MIN=20
# Token refreshes per minute per client IP. Default 30.
RATE_LIMIT_REFRESH_PER_MIN=30
