# Runtime mode (REQUIRED): development | test | production. There is no default.
NODE_ENV=development
# Allowed browser origins, comma-separated (REQUIRED in production, no "*").
CORS_ORIGINS=http://localhost:3000
# Deprecated: still read (with a warning) for one release; use CORS_ORIGINS.
#CORS_ORIGIN=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db_name
# Runtime login: a member of bedest_app, never a superuser (see README
# "Database roles & RLS"; create it with src/scripts/database/ProvisionRoles.ts).
DATABASE_USER=bedest_app_login
DATABASE_PASSWORD=change-me
# Schema owner for migrations and maintenance scripts only (script-only;
# falls back to DATABASE_USER/DATABASE_PASSWORD when unset).
DATABASE_MIGRATION_USER=postgres
DATABASE_MIGRATION_PASSWORD=postgres
# Superuser credentials for ProvisionRoles.ts only (script-only).
#DATABASE_ADMIN_USER=postgres
#DATABASE_ADMIN_PASSWORD=postgres
DATABASE_MIGRATION_DIR=drizzle
# Postgres TLS: disable | require (encrypted, certificate NOT verified) |
# verify-full. Default: verify-full in production, disable otherwise.
#DATABASE_SSL_MODE=verify-full
# CA for verify-full: PEM content or a path to a PEM file.
#DATABASE_SSL_CA=/etc/ssl/certs/db-ca.pem

# JWT signing secrets: at least 32 random characters each, different from
# each other. The placeholders below are refused when NODE_ENV=production.
SECRET_KEY=change-me-access-secret-at-least-32-characters
REFRESH_KEY=change-me-refresh-secret-at-least-32-characters
# JWT "iss" claim set on every token and checked on verify. Default: bedest.
# Changing it invalidates every issued token (users log in again).
#JWT_ISSUER=bedest

PORT=3000

LOCAL_STORAGE_PATH=./uploads

#S3_BUCKET=your-bucket-name
#S3_REGION=us-east-1
#S3_ACCESS_KEY=your-access-key
#S3_SECRET_KEY=your-secret-key
#S3_ENDPOINT=http://localhost:9000
# Path-style addressing (endpoint/bucket/key). Default false (AWS virtual-hosted
# style); set true for MinIO and most S3-compatible stores.
#S3_FORCE_PATH_STYLE=false

# --- Seed script only (bun run db:seed); never read by the server ---
# E-mail of the initial SYSTEM user (REQUIRED for seeding).
SEED_SYSTEM_EMAIL=admin@example.com
# Optional. When unset a random 24-character password is generated and printed once.
#SEED_SYSTEM_PASSWORD=
# Seeding is refused when NODE_ENV=production unless this is true.
#ALLOW_PRODUCTION_SEED=false

# --- Reset scripts only (bun run db:reset / dev:setup); never read by the server ---
# Must equal DATABASE_NAME to confirm the destructive reset (or pass --yes).
# Resets are always refused when NODE_ENV=production.
#CONFIRM_RESET=

# --- Redis (optional) ---
# Shared rate limits, lockout counters, maintenance/session invalidation and
# WebSocket fan-out across nodes; in-memory/table fallbacks without it.
#REDIS_URL=redis://localhost:6379

# --- Client IP & rate limiting ---
# Number of trusted reverse proxies in front of the app. 0 (default) ignores
# X-Forwarded-For; N uses the entry at position -N of X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Login attempts per minute per (client IP + e-mail). Default 5.
RATE_LIMIT_LOGIN_PER_MIN=5
# Login attempts per minute per client IP, any e-mail. Default 20.
RATE_LIMIT_LOGIN_IP_PER_MIN=20
# Token refreshes per minute per client IP. Default 30.
RATE_LIMIT_REFRESH_PER_MIN=30
# Public tenant resolutions (GET /api/v1/public/resolve) per minute per client IP. Default 30.
RATE_LIMIT_TENANT_RESOLVE_PER_MIN=30
# Password-reset requests per minute per client IP.
RATE_LIMIT_PASSWORD_FORGOT_PER_MIN=5
# Password-reset requests per hour per e-mail address.
RATE_LIMIT_PASSWORD_FORGOT_PER_HOUR=3

# --- E-mail (password reset, invitations) ---
# smtp, or console (development only: nothing is delivered, refused in production).
MAIL_PROVIDER=console
# Public URL of the web app; e-mail links are APP_PUBLIC_URL/reset-password#token=...
# and APP_PUBLIC_URL/accept-invite#token=...
APP_PUBLIC_URL=http://localhost:5173
# Required when MAIL_PROVIDER=smtp:
#MAIL_FROM=Bedest <no-reply@example.com>
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=change-me
#SMTP_PASSWORD=change-me
# true = TLS from the first byte (port 465); false = STARTTLS when offered.
#SMTP_SECURE=false

# --- Billing (Stripe webhooks) ---
# Webhook signing secret (whsec_...). Leave unset to disable the billing
# webhook route entirely (it is then not mounted).
#BILLING_WEBHOOK_SECRET=

# --- Storage ---
# Comma-separated MIME allowlist for direct and presigned uploads.
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
# Maximum size of one stored file in bytes (default 5 MiB).
STORAGE_MAX_BYTES=5242880

# --- Process ---
# Hard deadline (ms) for the graceful shutdown before exiting with code 1.
SHUTDOWN_TIMEOUT_MS=15000

# --- Background jobs [FEAT-08] ---
# Session/token cleanup, storage purge, notification retention. Default true;
# only one node runs each job at a time (advisory lock).
JOBS_ENABLED=true
# Days a soft-deleted file is kept before its object is purged. Default 30.
STORAGE_PURGE_AFTER_DAYS=30
# Days a notification is kept before it is soft-deleted. Default 180.
NOTIFICATION_RETENTION_DAYS=180
# Largest accepted request body in bytes (default 10 MiB); must be at least
# STORAGE_MAX_BYTES + 65536.
#MAX_REQUEST_BODY_BYTES=10485760
# Log level: fatal | error | warn | info | debug | trace | silent.
# Default info (silent when NODE_ENV=test).
#LOG_LEVEL=info

# --- API documentation ---
# /api/docs is served outside production; set true to serve it in production.
#ENABLE_API_DOCS=false
