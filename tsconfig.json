{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@f/*": ["./src/features/*"],
      "@/*": ["./src/*"],
    },
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src", "client", "drizzle.config.ts"],
}
